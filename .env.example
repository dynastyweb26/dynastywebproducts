# Stripe secret key (server-side only, never exposed to the browser).
# Use a test-mode key (sk_test_...) for preview, live key (sk_live_...) for production.
STRIPE_SECRET_KEY=

# Absolute origin of the deployed site, used to build Checkout success/cancel URLs.
# No trailing slash. Example: https://dynastywebproducts.vercel.app
# On Vercel this can be left blank and VERCEL_URL is used as a fallback.
SITE_URL=

# STRIPE_WEBHOOK_SECRET is intentionally omitted from v1. Orders are recorded
# in the Stripe dashboard (email, phone, shipping address, line-item names).
# Add this when a database-backed orders table and webhook are introduced.
